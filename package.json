{
  "name": "midterm-review-site",
  "version": "1.0.0",
  "private": true,
  "description": "微积分 A1 与线性代数期中复习站：讲义要点、自编题库、题目投稿归档",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "check": "node build.mjs --check-only",
    "fonts": "node scripts/fonts.mjs",
    "new:question": "node scripts/new-question.mjs",
    "lint": "node node_modules/@taste/lint.mjs",
    "inspect": "node node_modules/@taste/inspect.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.1",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0"
  }
}
