    "new:question": "node scripts/new-question.mjs",
    "issue": "node scripts/issue-to-question.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0"
  }
