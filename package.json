{
  "name": "midterm-review-site",
  "version": "1.0.0",
  "private": true,
  "description": "微积分 A1 与线性代数期中复习站：讲义要点、自编题库、题目投稿归档",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
